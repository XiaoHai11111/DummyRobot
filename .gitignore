# ---------------------------------------------------------------------------
# 3D / CAD 临时文件（不属于设计数据，不应提交）
# ---------------------------------------------------------------------------

# SolidWorks 打开文件时生成的锁文件（文件名以 ~$ 开头）
~$*

# SolidWorks 备份 / 自动恢复文件
*.sldbak

# 通用 CAD 临时、自动保存与备份文件
*.tmp
*.temp
*.bak
*.autosave
*.asv

# AutoCAD 自动保存 / 图纸锁定文件
*.sv$
*.dwl
*.dwl2

# Blender 自动备份
*.blend1
*.blend2

# FreeCAD 自动备份
*.FCStd1
*.FCStd2

# SketchUp 备份文件
*.skb

# Rhino 文件锁
*.rhl

